# lobsterfleet env. Copy to .env and fill in.
# Only a few of these are required to boot. See README for the quickstart.

# ----------------------------------------------------------------------------
# Core runtime (paths + port)
# ----------------------------------------------------------------------------

# Port the server listens on.
PORT=8088

# Where the sqlite db lives. Keep it under the data volume so it survives restarts.
DATABASE_PATH=./data/lobsterfleet.db

# Where the built SPA is served from. Leave unset in Docker/LXC (we copy web/dist
# next to the server and the default resolves it). Only set if you moved it.
# WEB_DIST=/app/web/dist

# Where session log archives go (the old R2 buckets become local disk).
SESSION_ARCHIVE_DIR=./data/archives

# Externally reachable app URL. Used in redirects and agent session env.
# Set this to your LXC, reverse proxy, or domain URL in production.
LOBSTERFLEET_PUBLIC_URL=http://localhost:8088

# Local dev identity is enabled by default only for loopback, non-production
# local installs. Set this to 1 only for trusted local dev.
# LOBSTERFLEET_ENABLE_DEV_IDENTITY=0

# Optional comma-separated legacy hosts that should 308 redirect to the public URL.
# LOBSTERFLEET_REDIRECT_HOSTS=old.example.com

# Who to trust for X-Forwarded-Proto / Forwarded headers (they control https
# detection and the Secure cookie flag). Default: loopback + private ranges,
# which covers nginx/Traefik on the same box or LAN. "always" or "never" to override.
# LOBSTERFLEET_TRUST_PROXY=

# ----------------------------------------------------------------------------
# crabbox broker (the lease control plane) -- REQUIRED to provision boxes
# ----------------------------------------------------------------------------

# Broker base URL. This is the public crabbox coordinator.
CRABBOX_COORDINATOR_URL=https://broker.theutopialabs.com

# Bearer token for the broker. Get this from whoever runs the broker.
CRABBOX_COORDINATOR_TOKEN=

# Optional org tag sent as X-Crabbox-Org when your broker requires it.
CRABBOX_COORDINATOR_ORG=

# Owner tag sent as X-Crabbox-Owner so the broker groups your leases.
CRABBOX_OWNER=

# Public half of the app-managed SSH key. The broker drops this on each leased
# box so the server can SSH in. Generate a keypair, paste the public key here.
# e.g. ssh-keygen -t ed25519 -f data/crabbox_key -N ""  then paste the .pub
CRABBOX_COORDINATOR_SSH_PUBLIC_KEY=

# Private half of the same keypair. Keep this file readable only by the app user.
CRABBOX_SSH_PRIVATE_KEY_PATH=./data/crabbox_key

# Name for this app's SSH key in the provider account (e.g. Hetzner). Pick a
# unique name per install. Without it the broker uses its default key name and
# rejects your public key if that name is already taken by someone else's key.
CRABBOX_COORDINATOR_PROVIDER_KEY=lobsterfleet

# Optional lease shape. Sensible defaults apply if you leave these blank.
# CRABBOX_COORDINATOR_PROVIDER=hetzner
# CRABBOX_COORDINATOR_SERVER_TYPE=cx32
# CRABBOX_COORDINATOR_LOCATION=hel1
# CRABBOX_COORDINATOR_WORK_ROOT=/root/work
# CRABBOX_COORDINATOR_TTL_SECONDS=7200
# CRABBOX_COORDINATOR_IDLE_SECONDS=1800
# CRABBOX_COORDINATOR_DESKTOP=0
# CRABBOX_COORDINATOR_PUBLIC_URL=

# Break-glass owner login token. Prefer GitHub OAuth for normal browser access.
CRABBOX_BOOTSTRAP_TOKEN=

# ----------------------------------------------------------------------------
# Secrets at rest
# ----------------------------------------------------------------------------

# Key used to encrypt stored tokens (GitHub creds etc) in the db.
# 32 random bytes, base64. e.g. openssl rand -base64 32
CRABBOX_TOKEN_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# GitHub
# ----------------------------------------------------------------------------

# Personal access token. Powers issue/PR lookup (#123 search) and repo reads.
# This is the simplest GitHub setup for single-user mode.
GITHUB_TOKEN=

# GitHub OAuth (optional). Only needed if you want browser login instead of the
# local owner default. Create an OAuth app and fill these in.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8088/auth/github/callback
# Optional. When set, OAuth users must be active members of this GitHub org.
# GITHUB_ORG=

# ----------------------------------------------------------------------------
# Codex on leased boxes
# ----------------------------------------------------------------------------
# Requirement: codex is installed and authed on THIS host. Each leased crabbox
# gets the host's credential copied over (and codex installed if the image
# lacks it) during provisioning. Lookup order: LOBSTERFLEET_CODEX_AUTH_PATH,
# $CODEX_HOME/auth.json, ~/.codex/auth.json, then OPENAI_API_KEY.

# Explicit path to the codex auth.json. Leave unset to use ~/.codex/auth.json
# of the user running the server (the lobsterfleet user in an LXC).
# LOBSTERFLEET_CODEX_AUTH_PATH=

# Set to 0 to skip the codex bootstrap on new boxes entirely.
# LOBSTERFLEET_CODEX_BOOTSTRAP=1

# OpenAI API key. Used as the codex credential when no auth.json is found
# (handy for headless installs; keys do not need re-auth like ChatGPT tokens).
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_ORG_ID=
